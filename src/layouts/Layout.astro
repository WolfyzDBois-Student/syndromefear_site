---
const { title } = Astro.props;
import Navbar from "../components/Navbar.astro";

const isIndex = title === "Syndrome Fear";
const currentPath = Astro.url.pathname;
const basePath =
  currentPath.startsWith("/team") ||
  currentPath.startsWith("/project") ||
  currentPath.startsWith("/downloads") ||
  currentPath.startsWith("/links") ||
  currentPath.startsWith("/bug_report")
    ? "../"
    : "./";
---
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href={`${basePath}favicon.gif`} />

    <script is:inline>
      const saved = localStorage.getItem("daltonien-mode");
      const isDaltonien = saved === "1";
      const base = window.location.pathname.includes("/team") || window.location.pathname.includes("/project") || window.location.pathname.includes("/downloads") || window.location.pathname.includes("/links") || window.location.pathname.includes("/bug_report") ? "../" : "./";
      const styleHref = isDaltonien ? `${base}styles/daltonien.css` : `${base}styles/style.css`;
      document.write(`<link id="theme-style" rel="stylesheet" href="${styleHref}">`);
    </script>
    
  </head>

  <body class={isIndex ? "index-page" : ""}>
    <Navbar isIndex={isIndex} basePath={basePath} />
    <main>
      <slot />
    </main>

    <script src={`${basePath}js/nav-toggle.js`} defer></script>
    <script src={`${basePath}js/theme-toggle.js`} defer></script>
  </body>
</html>
