---
import BaseLayout from "../layouts/Layout.astro";
import "../styles/team.css";
---

<BaseLayout title="Ctrl+Alt+Elite">
  <div class="team-container">
    <section class="team-intro">
      <h2>Ctrl+Alt+Elite</h2>
      <p>
        Ctrl+Alt+Elite est une jeune entreprise fondée en 2024 par cinq
        étudiants passionnés d'informatique de l'EPITA. Leur premier projet,
        Syndrome Fear, combine narration immersive et programmation pointue.
      </p>
    </section>

    <section class="team-cards">
      <div class="team-card">
        <img src="https://syndromefear.wolfyz.fr/public/Louis.jpg" alt="Louis" class="team-photo" />
        <h3>Louis</h3>
        <p class="team-role">Responsable Enigme</p>
        <p class="team-tagline">Sur pied à 8h du matin</p>
      </div>

      <div class="team-card">
        <img src="https://syndromefear.wolfyz.fr/public/members/Pierre.jpg" alt="Pierre" class="team-photo" />
        <h3>Pierre</h3>
        <p class="team-role">Responsable Programmation</p>
        <p class="team-tagline">Plus efficace à 4h du matin qu'à midi</p>
      </div>

      <div class="team-card">
        <img src="https://syndromefear.wolfyz.fr/public/members/Thibault.jpg" alt="Thibault" class="team-photo" />
        <h3>Thibault</h3>
        <p class="team-role">Scenario & Communication</p>
        <p class="team-tagline">Dors sur le sol du Lab</p>
      </div>

      <div class="team-card">
        <img src="https://syndromefear.wolfyz.fr/public/members/Axel.jpg" alt="Axel" class="team-photo" />
        <h3>Axel</h3>
        <p class="team-role">Responsable Design</p>
        <p class="team-tagline">Commande Pepe Chicken avant de bosser</p>
      </div>

      <div class="team-card">
        <img src="https://syndromefear.wolfyz.fr/public/members/Bashir.jpg" alt="Bashir" class="team-photo" />
        <h3>Bashir</h3>
        <p class="team-role">Responsable Multijoueur</p>
        <p class="team-tagline">Il est là</p>
      </div>
    </section>
  </div>
</BaseLayout>
