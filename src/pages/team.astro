---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Ctrl+Alt+Elite">
  <div class="team-container">
    <section class="team-intro">
      <h2>Ctrl+Alt+Elite</h2>
      <p>
        Ctrl+Alt+Elite est une jeune entreprise fondée en 2024 par cinq étudiants passionnés d'informatique de l'EPITA.
        Leur premier projet, Syndrome Fear, combine narration immersive et programmation pointue.
      </p>
    </section>

    <section class="team-cards">
      <div class="team-card">
        <img src="../img/members/ctrlaltelite.png" alt="Louis" class="team-photo" />
        <h3>Louis</h3>
        <p class="team-role">Game Designer</p>
        <p class="team-tagline">"Sur pied à 8h du matin"</p>
      </div>

      <div class="team-card">
        <img src="../img/members/ctrlaltelite.pngg" alt="Pierre" class="team-photo" />
        <h3>Pierre</h3>
        <p class="team-role">Lead Developer</p>
        <p class="team-tagline">Pour être efficace, il faut être 4h du mat'</p>
      </div>

      <div class="team-card">
        <img src="../img/members/ctrlaltelite.png" alt="Thibault" class="team-photo" />
        <h3>Thibault</h3>
        <p class="team-role">Scenario & Communication</p>
        <p class="team-tagline">A une peluche de Yosh"</p>
      </div>

      <div class="team-card">
        <img src="../img/members/ctrlaltelite.png" alt="Axel" class="team-photo" />
        <h3>Axel</h3>
        <p class="team-role">Video Editor</p>
        <p class="team-tagline">S'ambiance tout seul dans la salle</p>
      </div>

      <div class="team-card">
        <img src="../img/members/ctrlaltelite.png" alt="Bashir" class="team-photo" />
        <h3>Bashir</h3>
        <p class="team-role">Technical Analyst</p>
        <p class="team-tagline">Il a vu de la lumière, il est entré</p>
      </div>
    </section>
  </div>
</BaseLayout>
