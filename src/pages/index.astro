---
import BaseLayout from '../layouts/Layout.astro';
import "../styles/index.css";
import "../styles/style.css";
import Auto1 from '../assets/auto/auto1.png';
import Auto2 from '../assets/auto/auto2.png';
// import Auto3 from '../assets/auto/auto3.png';
---

<script src="/js/galery.js" defer></script>

<BaseLayout title="Syndrome Fear">
  <main class="index-container">
    <section class="synopsis">
      <h2>Synopsis</h2>
      <p class="synopsis-text">
        A cold room, a flashing light, and a metallic taste... <br>
        You wake up with no memory of the past 48 hours. <br>
        Who are you? Why are you here? Your only clue: a locked door.
      </p>
    </section>

    <section class="gallery">
      <div class="gallery-wrapper">
        <img class="gallery-image" src={Auto1.src} alt="Image 1" />
        <img class="gallery-image hidden" src={Auto2.src} alt="Image 2" />
      </div>
    </section>
  </main>
</BaseLayout>
