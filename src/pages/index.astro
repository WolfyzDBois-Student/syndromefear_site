---
import BaseLayout from "../layouts/Layout.astro";
import "../styles/index.css";
---

<BaseLayout title="Syndrome Fear">
  <main class="index-container">
    <section class="synopsis">
      <p class="synopsis-text">
        Vous vous réveillez dans une pièce vide et froide <br />
        Vous ne vous souvenez de rien dans les dernières 48 heures <br />
        Où êtes-vous ? Que s'est-il passé ? <br />
        Devant vous, une porte, verrouillée... <br />
        <br />
        <a href="./downloads/build.zip" class="download-button" download>
          <i>&#8681;</i>Télécharger le jeu
        </a>
      </p>
    </section>

    <section class="gallery">
      <div class="gallery-wrapper">
        <div class="gallery-track">
          <img
            class="gallery-image"
            src="https://syndromefear.wolfyz.fr/public/auto/auto1.png"
            alt="Image 1"
          />
          <img
            class="gallery-image"
            src="https://syndromefear.wolfyz.fr/public/auto/auto2.png"
            alt="Image 2"
          />
          <img
            class="gallery-image"
            src="https://syndromefear.wolfyz.fr/public/auto/auto3.png"
            alt="Image 2"
          />
          <img
            class="gallery-image"
            src="https://syndromefear.wolfyz.fr/public/auto/auto4.png"
            alt="Image 2"
          />
        </div>
        <button class="gallery-btn prev">&#10094;</button>
        <button class="gallery-btn next">&#10095;</button>
      </div>
    </section>
  </main>

  <script src="./js/galery.js" defer></script>
  <script src="./js/nav-toggle.js" defer></script>
</BaseLayout>
